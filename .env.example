# Ключ Claude API: https://console.anthropic.com
# Тексты постов: бесплатные ИИ, нужен хотя бы один ключ. Несколько ключей одного сервиса — через запятую.
# Groq (лучший бесплатный лимит, ~1000 запросов в день): console.groq.com/keys
GROQ_API_KEY=
# Gemini (тот же GEMINI_API_KEY ниже, ~500 запросов в день на Flash-Lite): aistudio.google.com/apikey
# OpenRouter (бесплатные модели, ~50 запросов в день): openrouter.ai/keys
OPENROUTER_API_KEY=
# Cloudflare (CLOUDFLARE_ACCOUNT_ID и CLOUDFLARE_API_TOKEN ниже) тоже пишет тексты, токену нужно право Workers AI.
# Платный Claude, только если добавить anthropic в llm_providers в settings.yaml
ANTHROPIC_API_KEY=

# Отдельный бот на каждый канал (создаются в @BotFather). Бот должен быть админом канала.
CRYPTO_BOT_TOKEN=
CRYPTO_CHAT_ID=
NEWS_BOT_TOKEN=
NEWS_CHAT_ID=
ALERTS_BOT_TOKEN=
ALERTS_CHAT_ID=

# Приватный чат/группа, куда приходят черновики с кнопками ✅/❌ (числовой id, например -100123...)
# Каждый бот канала должен быть добавлен в этот чат.
REVIEW_CHAT_ID=

# Уведомления о проблемах (бот выкинут из канала, токен отозван)
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# ИИ-картинки для крипто-канала. Пробуются по очереди, достаточно любого; без ключей работает Pollinations.
# Cloudflare Workers AI (бесплатно, без карты): dash.cloudflare.com → AI → Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Pollinations (необязательно, бесплатный токен убирает водяной знак): auth.pollinations.ai
POLLINATIONS_TOKEN=
# Google Gemini: тексты бесплатно; картинки только с подключённой оплатой. aistudio.google.com/apikey
GEMINI_API_KEY=
